# Публичный адрес gateway: единственная точка входа (фронт, /api, /admin, /auth, /mail).
PUBLIC_URL=http://localhost:8080
# Публикация под префиксом за внешним прокси, который его срезает (app.nektarum.ru/fsp):
# PUBLIC_URL=https://app.nektarum.ru/fsp и BASE_PATH=/fsp. Для корня домена: пусто.
BASE_PATH=
GATEWAY_PORT=8080
# Куда бэк возвращает после входа и выхода. Пусто = PUBLIC_URL; для `pnpm dev` укажите http://localhost:5173.
FRONTEND_URL=

POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_DB=fsp
# Порт Postgres на хосте (только 127.0.0.1): для alembic и бэка вне Docker.
POSTGRES_PORT=5432

# Подписывает cookie сессии админки и состояния входа через Keycloak.
SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=change-me
# Секрет клиента fsp-career в реалме ФСП ID (mock на стенде).
FSP_ID_CLIENT_SECRET=change-me

# Доступ к веб-интерфейсу Mailpit (/mail), формат user:password.
MAILPIT_UI_AUTH=mail:mail

# Демо-режим для жюри: вход в песочницы без регистрации, экспресс-тест. Только на стенде проверки.
DEMO_MODE=false
