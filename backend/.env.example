# Для запуска бэка вне Docker (alembic, отладка). Postgres и Keycloak поднимаются из корневого docker-compose.yml.
# Вход через Keycloak работает только через gateway: redirect URI клиента указывает на PUBLIC_URL.
DATABASE_URL=postgresql+asyncpg://fsp:fsp@localhost:5432/fsp
SCORING_URL=http://localhost:8001
PUBLIC_URL=http://localhost:8080
SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
KEYCLOAK_INTERNAL_URL=http://localhost:8080/auth
KEYCLOAK_CLIENT_SECRET=change-me
FSP_ID_CLIENT_SECRET=change-me
